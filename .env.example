GEMINI_API_KEY=your_gemini_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_API_MODEL=openai/gpt-oss-20b
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHANNEL_ID=@your_channel_id
# دامنهٔ عمومی سایت برای ساخت لینک صفحهٔ خبر (بعد از deploy روی Netlify عوض شود)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# ---------- Instagram via Make (Phase 4c) ----------
# URL وب‌هوک Custom Webhook در Make Scenario (فعلاً خالی ⇒ اینستاگرام skipped می‌شود)
MAKE_WEBHOOK_URL=
# رشتهٔ تصادفی؛ در Make Router/Filter با هدر x-make-secret بررسی می‌شود
MAKE_SECRET=your_make_secret_here
PIPELINE_SECRET_KEY=your_random_secret_key_min_32_chars
