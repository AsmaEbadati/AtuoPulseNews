GEMINI_API_KEY=your_gemini_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_API_MODEL=openai/gpt-oss-20b
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHANNEL_ID=@your_channel_id
# دامنهٔ عمومی سایت برای ساخت لینک صفحهٔ خبر (بعد از deploy روی Netlify عوض شود)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# ---------- Instagram via Graph API (Phase 4c) ----------
# Access Token بلندمدت از Facebook Graph API Explorer + مجوز instagram_content_publish
INSTAGRAM_ACCESS_TOKEN=your_instagram_long_lived_access_token
# Instagram Account ID اکانت Business/Creator (عدد ~۱۷ رقمی)
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id
PIPELINE_SECRET_KEY=your_random_secret_key_min_32_chars
